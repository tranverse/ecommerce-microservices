# Copy this file to .env before running Docker Compose.
# Values below are local-development placeholders, not production secrets.

# Shared local infrastructure
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=replace_with_local_superuser_password
KAFKA_HOST_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Host ports. Compose binds them to 127.0.0.1 only.
GATEWAY_HOST_PORT=8080
AUTH_HOST_PORT=8081
USER_HOST_PORT=8082
PRODUCT_HOST_PORT=8083
INVENTORY_HOST_PORT=8084
ORDER_HOST_PORT=8085
PAYMENT_HOST_PORT=8086
NOTIFICATION_HOST_PORT=8087

# Auth Service
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=auth_app
AUTH_DB_PASSWORD=replace_with_local_auth_password
AUTH_DB_POOL_SIZE=5
AUTH_DB_MIN_IDLE=1
AUTH_JWT_ISSUER=http://localhost:8081
AUTH_JWT_ACCESS_TOKEN_TTL=PT15M
AUTH_JWT_REFRESH_TOKEN_TTL=P30D
# Production must provide matching PKCS#8 private and X.509 public RSA keys as Base64 DER.
# Local Compose intentionally permits an ephemeral key so no private key is committed.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_REQUIRE_CONFIGURED_KEY=false

# User Service
USER_DB_URL=jdbc:postgresql://localhost:5432/user_db
USER_DB_USERNAME=user_app
USER_DB_PASSWORD=replace_with_local_user_password
USER_DB_POOL_SIZE=5
USER_DB_MIN_IDLE=1
USER_AUTH_ISSUER=http://localhost:8081
USER_AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
USER_AUTH_CONNECT_TIMEOUT=PT2S
USER_AUTH_READ_TIMEOUT=PT2S

# Product Service
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/product_db
PRODUCT_DB_USERNAME=product_app
PRODUCT_DB_PASSWORD=replace_with_local_product_password
PRODUCT_DB_POOL_SIZE=5
PRODUCT_DB_MIN_IDLE=1

# Inventory Service
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db
INVENTORY_DB_USERNAME=inventory_app
INVENTORY_DB_PASSWORD=replace_with_local_inventory_password
INVENTORY_DB_POOL_SIZE=5
INVENTORY_DB_MIN_IDLE=1
INVENTORY_KAFKA_CONSUMER_GROUP=inventory-service-v1
INVENTORY_COMMANDS_TOPIC=inventory.commands.v1

# Order Service
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order_db
ORDER_DB_USERNAME=order_app
ORDER_DB_PASSWORD=replace_with_local_order_password
ORDER_DB_POOL_SIZE=5
ORDER_DB_MIN_IDLE=1
ORDER_AUTH_ISSUER=http://localhost:8081
ORDER_AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
ORDER_AUTH_CONNECT_TIMEOUT=PT2S
ORDER_AUTH_READ_TIMEOUT=PT2S
ORDER_PRODUCT_SERVICE_URL=http://localhost:8083
ORDER_PRODUCT_CONNECT_TIMEOUT=PT0.5S
ORDER_PRODUCT_READ_TIMEOUT=PT1.5S
ORDER_PRODUCT_RETRY_MAX_ATTEMPTS=2
ORDER_PRODUCT_RETRY_WAIT_DURATION=PT0.1S
ORDER_PRODUCT_CB_FAILURE_RATE_THRESHOLD=50
ORDER_PRODUCT_CB_SLIDING_WINDOW_SIZE=10
ORDER_PRODUCT_CB_MINIMUM_CALLS=5
ORDER_PRODUCT_CB_HALF_OPEN_CALLS=2
ORDER_PRODUCT_CB_OPEN_WAIT_DURATION=PT10S
ORDER_KAFKA_CONSUMER_GROUP=order-service-v1
INVENTORY_EVENTS_TOPIC=inventory.events.v1
PAYMENT_EVENTS_TOPIC=payment.events.v1

# Payment Service
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=replace_with_local_payment_password
PAYMENT_DB_POOL_SIZE=5
PAYMENT_DB_MIN_IDLE=1
PAYMENT_KAFKA_CONSUMER_GROUP=payment-service-v1
PAYMENT_COMMANDS_TOPIC=payment.commands.v1
PAYMENT_SIMULATOR_DECLINE_PAYMENTS=false
PAYMENT_SIMULATOR_UNAVAILABLE=false

# Notification Service
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=notification_app
NOTIFICATION_DB_PASSWORD=replace_with_local_notification_password
NOTIFICATION_DB_POOL_SIZE=5
NOTIFICATION_DB_MIN_IDLE=1
NOTIFICATION_KAFKA_CONSUMER_GROUP=notification-service-v1
ORDER_EVENTS_TOPIC=order.events.v1
NOTIFICATION_MESSAGING_LISTENER_ENABLED=true
NOTIFICATION_SIMULATOR_FAIL_DELIVERIES=false

# API Gateway
GATEWAY_AUTH_ISSUER=http://localhost:8081
GATEWAY_AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
GATEWAY_JWKS_CONNECT_TIMEOUT=PT2S
GATEWAY_JWKS_READ_TIMEOUT=PT2S
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
ORDER_SERVICE_URL=http://localhost:8085
