# Product Service local development
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/product_db
PRODUCT_DB_USERNAME=product_app
PRODUCT_DB_PASSWORD=replace_with_local_password

# Inventory Service local development
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db
INVENTORY_DB_USERNAME=inventory_app
INVENTORY_DB_PASSWORD=replace_with_local_password

# Auth Service local development
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=auth_app
AUTH_DB_PASSWORD=replace_with_local_password
# Production must provide matching PKCS#8 private and X.509 public RSA keys as Base64 DER.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=

USER_DB_URL=jdbc:postgresql://user-db:5432/user_db
USER_DB_USERNAME=user_app
USER_DB_PASSWORD=change-me
USER_AUTH_ISSUER=http://auth-service:8081
USER_AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
USER_AUTH_CONNECT_TIMEOUT=PT2S
USER_AUTH_READ_TIMEOUT=PT2S

GATEWAY_AUTH_ISSUER=http://auth-service:8081
GATEWAY_AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
GATEWAY_JWKS_CONNECT_TIMEOUT=PT2S
GATEWAY_JWKS_READ_TIMEOUT=PT2S
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
PRODUCT_SERVICE_URL=http://product-service:8083
INVENTORY_SERVICE_URL=http://inventory-service:8084
